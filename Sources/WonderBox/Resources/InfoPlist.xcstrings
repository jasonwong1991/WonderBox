{
  "sourceLanguage" : "en",
  "strings" : {
    "NSAppleEventsUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WonderBox uses Finder to move selected items to the Trash, read its size and empty it only when you confirm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过 Finder 将所选项目移入废纸篓、读取废纸篓容量，并仅在确认后清空。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
